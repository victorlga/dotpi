# Prerequisites for the dotpi setup. Used by install.sh via `brew bundle`.
# Add cask installs (e.g. Google Chrome for the web-browser skill) manually if you want them.

brew "node"      # runtime for pi and its extensions/skills
brew "git"
brew "ripgrep"   # used by pi tooling and many skills
brew "gh"        # used by the /review extension's PR mode

tap "yvgude/lean-ctx"
brew "yvgude/lean-ctx/lean-ctx"  # CLI backing the pi-lean-ctx package (context compression)
